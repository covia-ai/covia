{
  "name": "Scan untrusted text with SonnyLabs",
  "description": "Scans externally supplied text before it enters an LLM context or controls an action. Returns SonnyLabs prompt-injection and related safety findings plus its allow/warn/flag/block decision. This is an explicit tool, not automatic prompt filtering; scanner failures fail the operation.",
  "operation": {
    "adapter": "sonnylabs:scan",
    "default": {
      "surface": "user_message",
      "capture": false
    },
    "secretFields": ["apiKey"],
    "input": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "description": "Exact untrusted text to scan before it enters an LLM context or influences an action. Do not summarise or interpret it first."
        },
        "surface": {
          "type": "string",
          "enum": ["user_message", "assistant_output", "tool_result", "tool_params", "document", "agent_message", "mcp_resource", "mcp_tool_description"],
          "description": "Where the text will be used; defaults to user_message."
        },
        "tier": {
          "type": "string",
          "enum": ["fast", "accurate", "auto"],
          "description": "Prompt-injection detector tier. Omit to use SonnyLabs auto selection."
        },
        "capture": {
          "type": "boolean",
          "description": "Whether SonnyLabs may retain the raw content for later retrieval; defaults to false."
        },
        "policyId": {
          "type": "string",
          "minLength": 1,
          "description": "Optional SonnyLabs policy identifier."
        },
        "context": {
          "type": "object",
          "properties": {
            "agent_id": {"type": "string"},
            "session_id": {"type": "string"},
            "mcp_server": {"type": "string"},
            "trace_id": {"type": "string"},
            "end_user_id": {"type": "string"}
          },
          "additionalProperties": false,
          "description": "Optional SonnyLabs correlation context."
        },
        "apiKey": {
          "type": "string",
          "pattern": "^/?s/.+",
          "description": "Optional caller-owned secret reference; normally omit to use the venue credential at s/SONNY_LABS. Never pass a raw key."
        },
        "idempotencyKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "description": "Optional stable key for deduplicating a retry. A fresh UUID is generated when omitted."
        }
      },
      "required": ["text"],
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "properties": {
        "id": {"type": "string"},
        "created": {"type": "string"},
        "kind": {"type": "string"},
        "surface": {"type": "string"},
        "context": {"type": "object"},
        "findings": {"type": "array"},
        "decision": {
          "type": "object",
          "properties": {
            "action": {"type": "string", "enum": ["blocked", "flagged", "warned", "allowed"]},
            "reason": {"type": "string"}
          },
          "required": ["action"]
        },
        "content_stored": {"type": "boolean"},
        "content": {"type": "object"}
      },
      "required": ["id", "kind", "surface", "findings", "decision", "content_stored"],
      "additionalProperties": true
    }
  }
}
