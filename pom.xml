<project xmlns="https://maven.apache.org/POM/4.0.0"
	xmlns:xsi="https://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>ai.covia</groupId>
	<artifactId>covia</artifactId>
	<version>0.9.8-SNAPSHOT</version>
	<packaging>pom</packaging>

	<name>Covia</name>
	<description>Covia — open-source infrastructure for federated AI orchestration, built on Convex lattice technology.</description>
	<url>https://covia.ai</url>

	<licenses>
		<license>
			<name>Eclipse Public License - v 2.0</name>
			<url>https://www.eclipse.org/legal/epl-2.0/</url>
		</license>
	</licenses>

	<developers>
		<developer>
			<name>Mike Anderson</name>
			<email>mike@covia.ai</email>
			<organization>Covia</organization>
			<organizationUrl>https://covia.ai</organizationUrl>
		</developer>
	</developers>

	<scm>
		<connection>scm:git:git://github.com/covia-ai/covia.git</connection>
		<developerConnection>scm:git:ssh://github.com:covia-ai/covia.git</developerConnection>
		<url>https://github.com/covia-ai/covia.git</url>
	</scm>

	<distributionManagement>
		<snapshotRepository>
			<id>central</id>
			<url>https://central.sonatype.com/repository/maven-snapshots/</url>
		</snapshotRepository>
	</distributionManagement>

	<properties>
		<maven.compiler.release>21</maven.compiler.release>
		<maven.compiler.source>21</maven.compiler.source>
		<junit.version>6.1.3</junit.version>
		<convex.version>0.8.15</convex.version>
		<maven.compiler.target>21</maven.compiler.target>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		
		<logback.version>1.6.3</logback.version>
		<slf4j.version>2.0.18</slf4j.version>
		<javalin.version>7.2.3</javalin.version>
		<langchain.version>1.19.0</langchain.version>
		<mcp.version>2.0.1</mcp.version>
		<a2a.version>1.2.0.Final</a2a.version>
		<!-- Extra flags for forked test JVMs; the jdk23-plus-tests profile fills it. -->
		<covia.test.jvmflags></covia.test.jvmflags>
	</properties>

	<modules>
		<module>covia-core</module>
		<module>covia-python</module>
		<module>venue</module>
		<module>covia-python-adapter</module>
		<module>workbench</module>
		<module>covia-sql</module>
		<module>covia-telegram</module>
		<module>covia-discord</module>
		<module>covia-sonnylabs</module>
		<module>covia-documents</module>
		<module>covia-claude-code</module>
	</modules>

	<build>
		<pluginManagement>
			<plugins>
				<!-- Module integration tests inherit the same JVM flags as unit tests. -->
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-failsafe-plugin</artifactId>
					<version>3.5.6</version>
					<configuration>
						<argLine>${covia.test.jvmflags}</argLine>
					</configuration>
				</plugin>
			</plugins>
		</pluginManagement>
		<plugins>
			<!-- One reusable test JVM per module; all test concurrency is owned by
			     JUnit, which can respect class/method isolation annotations. Do not
			     use Surefire's multi-fork or class-level parallel schedulers. Shared
			     mutable fixtures opt out with @Execution(SAME_THREAD); the 0.5 factor
			     leaves headroom for venue worker threads and GC under load. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<version>3.5.6</version>
				<configuration>
					<argLine>${covia.test.jvmflags}</argLine>
					<forkCount>1</forkCount>
					<reuseForks>true</reuseForks>
					<properties>
						<configurationParameters>
							junit.jupiter.execution.parallel.enabled = true
							junit.jupiter.execution.parallel.mode.classes.default = concurrent
							junit.jupiter.execution.parallel.mode.default = concurrent
							junit.jupiter.execution.parallel.config.strategy = dynamic
							junit.jupiter.execution.parallel.config.dynamic.factor = 0.5
						</configurationParameters>
					</properties>
				</configuration>
			</plugin>

			<!-- Use this to require a minimum Maven version -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-enforcer-plugin</artifactId>
				<version>3.6.3</version>
				<executions>
					<execution>
						<id>enforce-maven</id>
						<goals>
							<goal>enforce</goal>
						</goals>
						<configuration>
							<rules>
								<requireMavenVersion>
									<version>3.7</version>
								</requireMavenVersion>
							</rules>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<!-- Central requires a sources jar and a javadoc jar alongside every
			     published artifact. Attach both for every module. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-source-plugin</artifactId>
				<version>3.4.0</version>
				<executions>
					<execution>
						<id>attach-sources</id>
						<goals><goal>jar-no-fork</goal></goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-javadoc-plugin</artifactId>
				<version>3.12.0</version>
				<configuration>
					<!-- Publish must not fail on Javadoc lint; generated sources and
					     terse doc comments would otherwise block a release. -->
					<doclint>none</doclint>
					<failOnError>false</failOnError>
				</configuration>
				<executions>
					<execution>
						<id>attach-javadocs</id>
						<goals><goal>jar</goal></goals>
					</execution>
				</executions>
			</plugin>

			<!-- Sonatype Central Publishing: bundles every module's artifacts and
			     uploads them to Maven Central on `mvn deploy`. Credentials come from
			     the `central` server entry in ~/.m2/settings.xml. -->
			<plugin>
				<groupId>org.sonatype.central</groupId>
				<artifactId>central-publishing-maven-plugin</artifactId>
				<version>0.11.0</version>
				<extensions>true</extensions>
				<configuration>
					<publishingServerId>central</publishingServerId>
					<checksums>all</checksums>
					<autoPublish>true</autoPublish>
				</configuration>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<!-- Release profile: GPG-signs all artifacts (Central requires signatures).
		     Activate with `-Prelease` (BUILD.md) or by setting performRelease=true.
		     Requires a GPG signing key configured locally. -->
		<profile>
			<id>release</id>
			<activation>
				<property>
					<name>performRelease</name>
					<value>true</value>
				</property>
			</activation>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-gpg-plugin</artifactId>
						<version>3.2.8</version>
						<configuration>
							<!-- The Covia release-signing key ("Covia Releases
							     <mike@covia.ai>", ed25519). Public info — pinning it
							     here means no other key on the operator's ring can be
							     picked up by accident. The gpg *executable* is
							     machine-specific and comes from the operator's
							     settings.xml gpg profile (see BUILD.md). -->
							<keyname>50211D99AC2D33BBCE2E2E967E88537C3387A49C</keyname>
						</configuration>
						<executions>
							<execution>
								<id>sign-artifacts</id>
								<phase>verify</phase>
								<goals><goal>sign</goal></goals>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>

		<!-- JDK 23+ prints one warning per JVM when a library touches
		     sun.misc.Unsafe memory access (JEP 471); protobuf-java still does. It
		     is addressed to that library's maintainers, not to this build, so test
		     JVMs allow it and a passing build prints nothing. The Docker image
		     sets the same flag for the venue itself. -->
		<profile>
			<id>jdk23-plus-tests</id>
			<activation>
				<jdk>[23,)</jdk>
			</activation>
			<properties>
				<covia.test.jvmflags>--sun-misc-unsafe-memory-access=allow</covia.test.jvmflags>
			</properties>
		</profile>
	</profiles>
</project>
