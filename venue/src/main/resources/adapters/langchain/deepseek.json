{
	"name":"DeepSeek Chat",
	"creator":"Mike Anderson",
	"description":"Chat with DeepSeek V4 through its OpenAI-compatible endpoint. V4 Flash is the balanced/economical default; V4 Pro targets harder work.",
	"dateCreated":"2025-09-16T00:00:00Z",
	"dateModified": "2025-09-16T00:00:00Z",
	"keywords":["LLM", "model", "deepseek"],
	"operation": {
		"adapter": "langchain:deepseek",
		"secretKey": "DEEPSEEK_API_KEY",
		"secretFields": ["apiKey"],

		"input":{
			"type":"object",
			"properties":{
				"prompt":{
					"type":"string",
					"description":"The prompt for the model."
				},
				"model":{
					"type":"string",
					"description":"Optional model name (defaults to deepseek-v4-flash)",
					"default":"deepseek-v4-flash"
				},
				"systemPrompt":{
					"type":"string",
					"description":"System prompt to set the AI's behaviour and context"
				},
				"apiKey":{
					"type":"string",
					"secret":true,
					"description":"API key for authentication"
				},
				"url":{
					"type":"string",
					"description":"Base URL (defaults to https://api.deepseek.com/v1)",
					"default":"https://api.deepseek.com/v1"
				},
				"temperature":{
					"type":"number",
					"description":"Sampling temperature (e.g. 0 for deterministic extraction); provider default when omitted"
				},
				"topP":{
					"type":"number",
					"description":"Nucleus sampling top_p; provider default when omitted"
				}
			}
		},
		"output":{
			"type":"object",
			"properties":{
				"response":{
					"type":"string",
					"description":"The LLM response"
				},
				"think":{
					"type":"string",
					"description":"Model thought process"
				}
			}
		}
	}
}

