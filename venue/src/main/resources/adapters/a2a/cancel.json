{
	"name": "A2A Cancel Task",
	"description": "Request cancellation of a Task on a remote A2A agent via the CancelTask JSON-RPC method",
	"operation": {
		"adapter": "a2a:cancel",
		"readOnly": false,
		"input": {
			"type": "object",
			"properties": {
				"agent": {
					"type": "string",
					"description": "Imported A2A agent Asset reference."
				},
				"id": {
					"type": "string",
					"description": "Remote Task ID to cancel"
				}
			},
			"required": ["agent", "id"]
		},
		"output": {
			"type": "object",
			"description": "The canceled A2A Task object"
		}
	}
}
