{
	"name": "A2A Get Task",
	"description": "Retrieve the current state of a Task on a remote A2A agent via the GetTask JSON-RPC method",
	"operation": {
		"adapter": "a2a:getTask",
		"readOnly": true,
		"input": {
			"type": "object",
			"properties": {
				"agent": {
					"type": "string",
					"description": "Imported A2A agent Asset reference."
				},
				"id": {
					"type": "string",
					"description": "Remote Task ID to query"
				}
			},
			"required": ["agent", "id"]
		},
		"output": {
			"type": "object",
			"description": "A2A Task object — see https://a2a-protocol.org/latest/specification/"
		}
	}
}
