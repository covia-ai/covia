    "config": {"systemPrompt": "You are a capable general-purpose agent.", "defaultTools": false, "skillsets": ["w/skills", "v/skills/root"]},
    "may": [["crud/read", "w/report"], ["crud/write", "w/report"], ["invoke", "v/test/ops/echo"]],
    "mayNot": [["crud/read", "did:test:migration-e2e-other/w/shared/doc"]]
  },
  {
    "id": "released-no-config",
    "why": "An agent created with no config at all",
    "config": null,
    "may": [["crud/write", "w/report"]],
    "mayNot": [["crud/read", "did:test:migration-e2e-other/w/shared/doc"]]
  },
  {
    "id": "released-null-caps",
    "why": "A null caps field is no narrowing (COG-13), the same as none",
    "config": {"caps": null},
    "may": [["crud/write", "w/report"]],
    "mayNot": [["crud/read", "did:test:migration-e2e-other/w/shared/doc"]]
  },
  {
    "id": "released-reader",
    "why": "0.10.0's reader template: an empty with matches any resource, for only the abilities its can names",
    "config": {
      "systemPrompt": "You are a read-only data analyst.",
      "tools": ["v/ops/covia/inspect", "v/ops/covia/read", "v/ops/covia/list", "v/ops/covia/slice"],
      "loads": {"v/skills/data/lattice": {"skill": true, "budget": 2000, "label": "lattice"}},
      "defaultTools": false,
      "skillsets": ["w/skills"],
      "skills": ["v/skills/root/discovery", "v/skills/ops-tools/provenance", "v/skills/data/assets", "v/skills/root/skills"],
      "caps": [{"with": "", "can": "crud/read"}, {"with": "", "can": "asset/read"}]
    },
    "may": [["crud/read", "w/report"], ["crud/read", "g/released-bob/n/note"], ["asset/read", "a/doc"]],
    "mayNot": [["crud/write", "w/report"], ["invoke", "v/test/ops/echo"], ["crud/read", "did:test:migration-e2e-other/w/shared/doc"]]
  },
  {
    "id": "released-ap-alice",
    "why": "The AP demo's scanner: empty caps, so its model runs but no tool does",
    "config": {
      "operation": "v/ops/goaltree/chat",
      "llmOperation": "v/test/ops/llm",
      "model": "gpt-5.4-mini",
      "defaultTools": false,
      "caps": [],
      "systemPrompt": "You are Alice, an AP Invoice Scanner."
    },
    "may": [],
    "mayNot": [["crud/read", "w/report"], ["invoke", "v/test/ops/echo"], ["agent/request", "g/released-bob"]]
  },
  {
    "id": "released-ap-bob",
    "why": "The AP demo's enricher: separate grants over several subtrees, with the config fields an agent can carry",
    "config": {
      "operation": "v/ops/goaltree/chat",
      "llmOperation": "v/test/ops/llm",
      "model": "gpt-5.4-mini",
      "defaultTools": false,
      "tools": ["v/ops/covia/read", "v/ops/covia/write", "v/ops/covia/list"],
      "caps": [
        {"with": "w/vendor-records/", "can": "crud/read"},
        {"with": "w/purchase-orders/", "can": "crud/read"},
        {"with": "w/docs/", "can": "crud/read"},
        {"with": "w/invoices/", "can": "crud"},
        {"with": "w/enrichments/", "can": "crud"}
      ],
      "systemPrompt": "You are Bob, an AP Data Enricher.",
      "context": [
        {"ref": "w/docs/data-guide", "label": "AP Data Guide"},
        {"op": "v/ops/covia/list", "input": {"path": "w/vendor-records"}, "label": "Known Vendors"}
      ],
      "outputs": {"complete": {"schema": {"type": "object", "properties": {"invoice_number": {"type": "string"}}, "required": ["invoice_number"], "additionalProperties": false}}}
    },
    "may": [["crud/read", "w/docs/guide"], ["crud/write", "w/invoices/1"], ["crud/delete", "w/enrichments/1"]],
    "mayNot": [["crud/write", "w/docs/guide"], ["crud/read", "w/payroll/1"], ["crud/read", "w/invoicesarchive/1"], ["crud/write", "g/released-bob/n/note"]]
  },
  {
    "id": "released-ap-carol",
    "why": "The AP demo's approver: a narrow write inside a wider read",
    "config": {
      "operation": "v/ops/goaltree/chat",
      "llmOperation": "v/test/ops/llm",
      "caps": [{"with": "w/", "can": "crud/read"}, {"with": "w/decisions/", "can": "crud"}]
    },
    "may": [["crud/read", "w/invoices/1"], ["crud/write", "w/decisions/1"]],
    "mayNot": [["crud/write", "w/invoices/1"]]
  },
  {
    "id": "released-ap-dave",
    "why": "The AP demo's coordinator: talks to agents and invokes anything, writes nothing",
    "config": {
      "operation": "v/ops/goaltree/chat",
      "llmOperation": "v/test/ops/llm",
      "tools": ["v/ops/covia/read", "v/ops/agent/request", "v/ops/agent/message", "subgoal", "compact", "more_tools"],
      "caps": [{"with": "w/", "can": "crud/read"}, {"with": "g/", "can": "agent/message"}, {"with": "g/", "can": "agent/request"}, {"with": "", "can": "invoke"}]
    },
    "may": [["crud/read", "w/report"], ["agent/request", "g/released-bob"], ["agent/message", "g/released-bob"], ["invoke", "v/test/ops/echo"]],
    "mayNot": [["crud/write", "w/report"], ["agent/write", "g/released-bob"]]
  },
  {
    "id": "released-notes",
    "why": "A bare n/ names the agent's own notes, not a sibling's and not its owner's",
    "config": {"caps": [{"with": "n/", "can": "crud"}]},
    "may": [["crud/write", "g/released-notes/n/note"]],
    "mayNot": [["crud/read", "g/released-bob/n/note"], ["crud/read", "w/report"]]
  },
  {
    "id": "released-named-notes",
    "why": "Another agent's notes named outright, by its path and by its owner's DID",
    "config": {"caps": [{"with": "g/released-bob/n/", "can": "crud/read"}, {"with": "did:test:migration-e2e/g/released-carol/n/", "can": "crud/read"}]},
    "may": [["crud/read", "g/released-bob/n/note"], ["crud/read", "g/released-carol/n/note"]],
    "mayNot": [["crud/write", "g/released-bob/n/note"], ["crud/read", "g/released-dave/n/note"]]
  },
  {
    "id": "released-another-users",
    "why": "Caps naming another user's data are not a grant from that user",
    "config": {"caps": [{"with": "did:test:migration-e2e-other/w/shared/", "can": "crud/read"}, {"with": "w/mine/", "can": "crud/read"}]},
    "may": [["crud/read", "w/mine/doc"]],
    "mayNot": [["crud/read", "did:test:migration-e2e-other/w/shared/doc"]]
  },
  {
    "id": "released-leading-slash",
    "why": "A with written with a leading slash has never matched a path, so it grants nothing",
    "config": {"caps": [{"with": "/w/leading/", "can": "crud/read"}]},
    "may": [],
    "mayNot": [["crud/read", "w/leading/doc"]]
  },
  {
    "id": "released-no-with",
    "why": "An absent with matches any resource, for only the abilities its can names; a separate rule refuses another user's resources",
    "config": {"caps": [{"can": "crud/read"}]},
    "may": [["crud/read", "w/report"]],
    "mayNot": [["crud/write", "w/report"], ["crud/read", "did:test:migration-e2e-other/w/shared/doc"]]
  },
  {
    "id": "released-any-ability",
    "why": "A can of * is every ability, on only the resources its with names",
    "config": {"caps": [{"with": "w/open/", "can": "*"}]},
    "may": [["crud/write", "w/open/doc"], ["crud/delete", "w/open/doc"]],
    "mayNot": [["crud/read", "w/closed/doc"]]
  },
  {
    "id": "released-destination",
    "why": "A grant limited to a destination by nb.url",
    "config": {"caps": [{"with": "v/ops/http/get", "can": "invoke", "nb": {"url": "https://api.example.com/"}}]},
    "may": [["invoke", "v/ops/http/get", "https://api.example.com/v1"]],
    "mayNot": [["invoke", "v/ops/http/get", "https://elsewhere.example.org/"], ["invoke", "v/ops/http/post", "https://api.example.com/v1"]]
  },
  {
    "id": "released-malformed",
    "why": "Only the caps vector is validated, so entries that are not capabilities can be stored; they grant nothing",
    "config": {"caps": ["w/", {"with": "w/reports/"}]},
    "may": [],
    "mayNot": [["crud/read", "w/reports/a"], ["crud/read", "w/report"], ["crud/write", "w/report"]]
  },
  {
    "id": "released-terminated",
    "why": "A terminated agent acts with nothing, whatever its config said",
    "status": "TERMINATED",
    "config": {"caps": [{"with": "w/", "can": "crud"}]},
    "may": [],
    "mayNot": [["crud/read", "w/report"]]
  },
  {
    "id": "released-public",
    "why": "A public agent as older releases wrote it: a2a.caps, which reads as accepting anyone",
    "config": {"a2a": {"public": true, "caps": [{"with": "g/released-public", "can": "agent/request"}]}},
    "may": [],
    "mayNot": []
  },
  {
    "id": "released-manager",
    "why": "A capped agent with authority to write the child it manages",
    "config": {"caps": [{"with": "g/released-child", "can": "agent/write"}, {"with": "g/", "can": "agent/create"}, {"can": "invoke"}]},
    "may": [["agent/write", "g/released-child"]],
    "mayNot": [["crud/read", "w/report"]]
  },
  {
    "id": "released-child",
    "why": "A child a capped agent made: no release recorded its maker, so its owner controls it",
    "config": {"caps": [{"with": "w/", "can": "crud/read"}]},
    "may": [["crud/read", "w/report"]],
    "mayNot": [["crud/write", "w/report"]]
  }
