<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>ai.covia</groupId>
		<artifactId>covia</artifactId>
		<version>0.9.0</version>
	</parent>
	<artifactId>venue</artifactId>
	<name>Covia Venue</name>
	<description>Covia venue server runtime: the grid node that hosts operations, agents, assets, and the REST/MCP/A2A APIs.</description>

	<properties>
		<!-- Test groups excluded from the default `mvn test`. `integration` hits
		     external services (network/Ollama); `durability` forks real JVMs and
		     relaunches venues for crash/restart survival (~14s, dominated by the
		     hard-kill test). CI overrides this to run durability on every push:
		     `-Dcovia.excludedTestGroups=integration`. Run durability locally with
		     the same override, or a single class via `-Dtest=`. -->
		<covia.excludedTestGroups>integration,durability</covia.excludedTestGroups>
	</properties>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<version>3.5.6</version>
				<configuration>
					<!-- Default excludes integration + durability (see the
					     covia.excludedTestGroups property above). Run an excluded
					     group explicitly with e.g. mvn test -Dgroups=durability
					     -Dcovia.excludedTestGroups= -->
					<excludedGroups>${covia.excludedTestGroups}</excludedGroups>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.15.0</version>
				<configuration>
					<annotationProcessorPaths>
						<annotationProcessorPath>
							<groupId>io.javalin.community.openapi</groupId>
							<artifactId>openapi-annotation-processor</artifactId>
							<version>${javalin.version}</version>
						</annotationProcessorPath>
					</annotationProcessorPaths>
				</configuration>
			</plugin>
			<plugin>
				<artifactId>maven-assembly-plugin</artifactId>
				<version>3.8.0</version>
				<configuration>
					<archive>
						<manifest>
							<mainClass>covia.venue.MainVenue</mainClass>
							<!-- Used to add Maven implementation version  -->
							<addDefaultImplementationEntries>
								true
							</addDefaultImplementationEntries>
						</manifest>
					</archive>
					<!-- Custom descriptor = jar-with-dependencies, minus dependency copies
					of openapi-plugin/** (convex-restapi's generated OpenAPI document was
					shadowing the venue's own — see the descriptor for details). -->
					<descriptors>
						<descriptor>src/assembly/covia-jar.xml</descriptor>
					</descriptors>
					<outputDirectory>${project.build.directory}</outputDirectory>

					<!-- This creates full covia.jar. We don't want it
					attached, just built -->
					<attach>false</attach>
					<appendAssemblyId>false</appendAssemblyId>
					<finalName>covia</finalName>
				</configuration>
				<executions>
					<execution>
						<id>create-archive</id>
						<!-- Use install phase so it doesn't go in deployed
						Maven artifacts'  -->
						<phase>install</phase>
						<goals>
							<goal>single</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
	
		</plugins>
	</build>

	<dependencies>
		<!-- Covia deps -->
		<dependency>
			<groupId>ai.covia</groupId>
			<artifactId>covia-core</artifactId>
			<version>${project.version}</version>
		</dependency>
	
		<!-- Logging -->
		<dependency>
			<groupId>ch.qos.logback</groupId>
			<artifactId>logback-classic</artifactId>
			<version>${logback.version}</version>
		</dependency>
	
		<!-- Convex / Lattice Tech -->
		<dependency>
			<groupId>world.convex</groupId>
			<artifactId>convex-core</artifactId>
			<version>${convex.version}</version>
		</dependency>
		<dependency>
			<groupId>world.convex</groupId>
			<artifactId>convex-peer</artifactId>
			<version>${convex.version}</version>
		</dependency>
		<dependency>
			<groupId>world.convex</groupId>
			<artifactId>convex-dlfs</artifactId>
			<version>${convex.version}</version>
		</dependency>
		<dependency>
			<groupId>world.convex</groupId>
			<artifactId>convex-java</artifactId>
			<version>${convex.version}</version>
		</dependency>
		<dependency>
			<groupId>world.convex</groupId>
			<artifactId>convex-restapi</artifactId>
			<version>${convex.version}</version>
		</dependency>
		
		<!-- Testing -->
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter-engine</artifactId>
			<version>${junit.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter-api</artifactId>
			<version>${junit.version}</version>
			<scope>test</scope>
		</dependency>


		<!-- MCP: Model Context protocol -->
		<dependency>
			<groupId>io.modelcontextprotocol.sdk</groupId>
			<artifactId>mcp</artifactId>
			<version>${mcp.version}</version>
		</dependency>

		<!-- A2A: Agent-to-Agent protocol. Official SDK used at the wire
		     boundary (server parse/encode) and in the outbound A2AAdapter.
		     Pin exact version to avoid drift. -->
		<dependency>
			<groupId>org.a2aproject.sdk</groupId>
			<artifactId>a2a-java-sdk-spec</artifactId>
			<version>${a2a.version}</version>
		</dependency>
		<dependency>
			<groupId>org.a2aproject.sdk</groupId>
			<artifactId>a2a-java-sdk-client-transport-jsonrpc</artifactId>
			<version>${a2a.version}</version>
		</dependency>
		<dependency>
			<groupId>org.a2aproject.sdk</groupId>
			<artifactId>a2a-java-sdk-http-client</artifactId>
			<version>${a2a.version}</version>
		</dependency>
		
		<!-- Langchain -->
		<dependency>
    		<groupId>dev.langchain4j</groupId>
   			<artifactId>langchain4j</artifactId>
			<version>${langchain.version}</version>
		</dependency>
		<dependency>
    		<groupId>dev.langchain4j</groupId>
    		<artifactId>langchain4j-ollama</artifactId>
    		<version>${langchain.version}</version> 
		</dependency>
		<dependency>
   			<groupId>dev.langchain4j</groupId>
  			<artifactId>langchain4j-open-ai</artifactId>
 			<version>${langchain.version}</version>
		</dependency>
		<dependency>
			<groupId>dev.langchain4j</groupId>
			<artifactId>langchain4j-anthropic</artifactId>
			<version>${langchain.version}</version>
		</dependency>

		<!-- Web / application server with Javalin -->
		<dependency>
	        <groupId>io.javalin.community.openapi</groupId>
	        <artifactId>openapi-annotation-processor</artifactId>
	        <version>${javalin.version}</version>
	        <scope>provided</scope>
    	</dependency>
		<dependency>
			<groupId>com.j2html</groupId>
			<artifactId>j2html</artifactId>
			<version>1.6.0</version>
		</dependency>
		<dependency>
			<groupId>io.javalin</groupId>
			<artifactId>javalin</artifactId>
			<version>${javalin.version}</version>
		</dependency>
		<dependency>
			<groupId>io.javalin.community.openapi</groupId>
			<artifactId>javalin-openapi-plugin</artifactId>
			<version>${javalin.version}</version>
		</dependency>
		<dependency>
			<groupId>io.javalin.community.openapi</groupId>
			<artifactId>javalin-swagger-plugin</artifactId>
			<version>${javalin.version}</version>
		</dependency>
		<dependency>
			<groupId>io.javalin.community.openapi</groupId>
			<artifactId>javalin-redoc-plugin</artifactId>
			<version>${javalin.version}</version>
		</dependency>
	</dependencies>
</project>
